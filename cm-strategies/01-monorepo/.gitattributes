# Line endings
*.sv    text eol=lf
*.svh   text eol=lf
*.v     text eol=lf
*.tcl   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf

# Binary EDA artifacts — Git LFS 권장 (예시)
*.lib       filter=lfs diff=lfs merge=lfs -text
*.gds       filter=lfs diff=lfs merge=lfs -text
*.lef       filter=lfs diff=lfs merge=lfs -text
*.vcd       filter=lfs diff=lfs merge=lfs -text
*.fst       filter=lfs diff=lfs merge=lfs -text

# Generated artifacts — diff 제외
**/build/**         linguist-generated=true
**/obj_dir/**       linguist-generated=true
