{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme-ssd.example.com/schemas/ip-yaml-v1.json",
  "title": "IP metadata (IPLM-lite v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "status", "language", "license",
               "description", "subsystem", "owner", "bus", "dependencies",
               "qual", "files"],
  "properties": {
    "name":        { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "version":     { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$" },
    "status":      { "enum": ["proto", "alpha", "qual", "gold"] },
    "language":    { "enum": ["SystemVerilog", "Verilog", "VHDL", "Chisel"] },
    "license":     { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "subsystem":   { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
    "owner":       { "type": "string", "pattern": "^@[A-Za-z0-9._/-]+$" },
    "backup":      { "type": "string", "pattern": "^@[A-Za-z0-9._/-]+$" },
    "reviewers":   { "type": "array", "items": { "type": "string", "pattern": "^@[A-Za-z0-9._/-]+$" } },
    "bus":         { "enum": ["axi", "apb", "ahb", "wishbone", "custom"] },
    "clocks":      { "type": "array", "items": { "type": "string" } },
    "resets":      { "type": "array", "items": { "type": "string" } },
    "parameters":  { "type": "object", "additionalProperties": true },
    "dependencies":{ "type": "array",  "items": { "type": "string" } },
    "qual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lint", "cdc", "coverage", "formal"],
      "properties": {
        "lint":     { "enum": ["pending", "pass", "fail", "n/a"] },
        "cdc":      { "enum": ["pending", "pass", "fail", "n/a"] },
        "coverage": { "enum": ["pending", "pass", "fail", "n/a"] },
        "formal":   { "enum": ["pending", "pass", "fail", "n/a"] },
        "qual_report": { "type": ["string", "null"] }
      }
    },
    "files": {
      "type": "object",
      "required": ["rtl", "sim"],
      "properties": {
        "rtl":     { "type": "array", "items": { "type": "string" } },
        "sim":     { "type": "array", "items": { "type": "string" } },
        "waivers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ci": {
      "type": "object",
      "properties": {
        "workflow":        { "type": "string" },
        "required_checks": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if":   { "properties": { "status": { "enum": ["qual", "gold"] } } },
      "then": { "required":   ["reviewers"] }
    }
  ]
}
