<?xml version="1.0" encoding="UTF-8"?>
<!--
  Release snapshot 템플릿. `tools/release.py` 가 본 템플릿을 채워서
  release-<sku>-<YYYYqQ>.xml 을 생성한다.
  실제 SHA 는 `repo manifest -r` 또는 `tools/repo_lite.py freeze` 산출.

  필수 메타데이터:
    - release_id     : ${RELEASE_ID}
    - sku            : ${SKU}
    - snapshot_date  : ${DATE}
    - builder        : ${USER}
    - manifest_src   : ${SRC_MANIFEST}
-->
<manifest>
  <notice>
    Release: ${RELEASE_ID}
    SKU:     ${SKU}
    Date:    ${DATE}
    Source:  ${SRC_MANIFEST}
    Builder: ${USER}
  </notice>
  <remote  name="acme" fetch="git@github.com:acme-ssd/" />
  <default remote="acme" />

  <!-- 25 IP + 5 SS + top + common + verif (총 34 project) 의 SHA 가 채워짐 -->
  ${PROJECTS}
</manifest>
